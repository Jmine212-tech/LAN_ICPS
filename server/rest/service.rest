@baseUrl = http://localhost:3010/api/services

### 1. GET all items
GET {{baseUrl}}

###

### 2. CREATE a new item
# @name createItem
POST {{baseUrl}}
Content-Type: application/json

{
  "brand": "iphone",
  "model": "10",
  "fault": "lcd",
  "price": 100
}

###

### 3. UPDATE an item (uses ID from step 2 if using VS Code REST Client)
@itemId = 6aa3b7d41431028962e16380

PUT {{baseUrl}}/{{itemId}}
Content-Type: application/json

{
  "brand": "iphone",
  "model": "11",
  "fault": "BG",
  "price": 50
}

###

### 4. DELETE an item
DELETE {{baseUrl}}/{{itemId}}
